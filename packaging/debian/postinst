#!/bin/bash
set -e

# @group Configuration : Reload systemd and restore the pre-upgrade service state
if command -v systemctl &>/dev/null && [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    upgrade_state=/run/alter-daemon-package-upgrade
    if [ -f "$upgrade_state" ]; then
        read -r was_enabled was_active < "$upgrade_state"
        case "$was_enabled:$was_active" in
            yes:yes|yes:no|no:yes|no:no) ;;
            *)
                echo "invalid saved alter-daemon upgrade state" >&2
                exit 1
                ;;
        esac
        if [ "$was_enabled" = yes ]; then
            systemctl enable alter-daemon.service
        fi
        if [ "$was_active" = yes ]; then
            systemctl start alter-daemon.service
            systemctl is-active --quiet alter-daemon.service
        fi
        rm -f "$upgrade_state"
    fi
fi

echo ""
echo "[RunDock] Installation complete!"
echo ""
echo "  Start the daemon:     alter daemon start"
echo "  Start a process:      alter start node -- server.js"
echo "  Open web dashboard:   alter web"
echo ""
echo "  Sandboxed system mode: sudo systemctl enable --now alter-daemon"
echo "  (System mode uses an isolated account and cannot access home directories.)"
echo ""
