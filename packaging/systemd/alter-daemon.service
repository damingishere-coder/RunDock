[Unit]
Description=RunDock process manager daemon (alter CLI compatibility service)
Documentation=https://github.com/damingishere-coder/RunDock
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/alter --internal-daemon --port 2999
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alter-daemon

[Install]
WantedBy=multi-user.target
